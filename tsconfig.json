{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["./*"]
    },                    
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "target": "ES6",
    "forceConsistentCasingInFileNames": true, 
    "strict": true,
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    "./App.tsx",
    "types",
    "__tests__"
  ],
  "exclude": ["**/node_modules", "**/Pods"],

}
